+                if straight.issubset(dice_set):
+                    return 30
+            return 0
+        elif category == 'big_straight':
+            dice_set = set(dice)
+            if dice_set == {1, 2, 3, 4, 5} or dice_set == {2, 3, 4, 5, 6}:
+                return 40
+            return 0
+        elif category == 'yacht':
+            if any(c == 5 for c in counts_list):
+                return 50
+            return 0
+        return 0
