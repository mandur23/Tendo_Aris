-async def retry_on_403_error(func, *args, max_retries: int = 3, base_delay: float = 2.0, **kwargs):
-    """
-    403 에러 발생 시 재시도하는 헬퍼 함수.
-    
-    Args:
-        func: 실행할 함수 (비동기 또는 동기)
-        *args: 함수에 전달할 위치 인자
