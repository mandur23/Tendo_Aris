-    def _prepare_prompt(self, prompt: str) -> str:
-        cleaned = (prompt or "").strip()
-        if len(cleaned) > LOCAL_AI_MAX_PROMPT_CHARS:
-            return cleaned[:LOCAL_AI_MAX_PROMPT_CHARS]
-        return cleaned
-
-    def _consume_switch_notice(self) -> Optional[str]:
