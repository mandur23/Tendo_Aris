-        parsed = self._post_json_sync(endpoint, payload)
-        message = parsed.get("message", {})
-        output_text = (message.get("content") or "").strip()
-        if not output_text:
-            raise RuntimeError("로컬 AI가 빈 응답을 반환했습니다.")
