+                        return
+                except Exception as e:
+                    logger.error(f"음성 채널 연결 실패: {e}")
+                    return
+            else:
+                return
+        
+        # 대기열에 추가
+        if message.guild.id not in self.tts_queue:
+            self.tts_queue[message.guild.id] = []
+        
+        settings = self.get_user_settings(message.author.id, message.guild.id)
