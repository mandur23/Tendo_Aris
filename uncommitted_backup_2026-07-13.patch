+            except Exception as e:
+                retry_count += 1
+                error_msg = str(e)
+                logger.warning(f"TTS_RVC 호출 중 오류 (시도 {retry_count}/{max_retries}): {error_msg}, voice={edge_voice}, text_length={len(text_to_use)}, text='{text_to_use[:20]}'")
+                
+                # "No audio was received" 오류는 Edge TTS 문제일 수 있음
