+MYSQL_DATABASE = os.getenv('MYSQL_DATABASE', 'tendo_aris')
+MYSQL_CHARSET = os.getenv('MYSQL_CHARSET', 'utf8mb4')
+
+# DB 사용 여부 (True면 MySQL 사용, False면 JSON 파일 사용)
+USE_MYSQL = os.getenv('USE_MYSQL', 'false').lower() == 'true'
