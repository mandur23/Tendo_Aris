+    
+    logging.basicConfig(
+        level=logging.INFO,
+        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
+        handlers=[
+            logging.StreamHandler(),
+            DateRotatingFileHandler(
+                base_dir="logs",
+                filename_base="yacht_bot",
+                encoding='utf-8'
+            )
+        ]
+    )
+    
+    discord_logger = logging.getLogger('discord')
+    discord_logger.setLevel(logging.WARNING)
