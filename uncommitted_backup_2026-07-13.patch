+        tts_rate = int((speed - 1.0) * 100) if speed != 1.0 else 0
+        
+        logger.debug(f"RVC TTS 호출: text='{text[:50]}{'...' if len(text) > 50 else ''}', voice={edge_voice}, pitch={pitch}, tts_rate={tts_rate}, filename={output_path.name}")
+        
