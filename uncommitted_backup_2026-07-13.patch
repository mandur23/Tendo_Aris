+                    if tts_file:
+                        cleanup_tts_file(tts_file)
+                    # 비동기로 대기열 처리
+                    asyncio.run_coroutine_threadsafe(
+                        self._handle_playback_error(ctx, music_player, volume_lowered, music_was_playing, music_was_paused),
