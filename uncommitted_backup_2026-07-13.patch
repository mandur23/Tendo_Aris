+                )
+                
+                # 반환된 경로 확인
+                possible_paths = []
+                
+                if isinstance(output_file, str):
+                    possible_paths.append(Path(output_file))
+                
+                # output_directory에 파일이 생성되었을 수 있음
+                possible_paths.append(Path(output_dir) / output_path.name)
+                
+                # 원래 output_path도 확인
